# Copy to .env and fill in. Never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=miadp
POSTGRES_USER=miadp
POSTGRES_PASSWORD=change-me-local-only

# Optional overrides (defaults shown)
# MIADP_STUDY_START=2023-01-09
# MIADP_STUDY_END=2023-01-15
# MIADP_TRAIN_END=2023-01-13
# MIADP_BBOX_MIN_LAT=40.3
# MIADP_BBOX_MAX_LAT=41.1
# MIADP_BBOX_MIN_LON=-74.4
# MIADP_BBOX_MAX_LON=-73.4
# MIADP_CHUNK_SIZE=250000
# MIADP_LOG_LEVEL=INFO

# API base URL used by the Streamlit app (optional)
# MIADP_API_URL=http://127.0.0.1:8000
